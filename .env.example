# ---------------------------------------------------------------------------
# booking-app environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development

# --- Database (Postgres) ---
# Local docker-compose default. In prod use the managed connection string.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking?schema=public

# --- Redis (locks, BullMQ, worker heartbeat) ---
REDIS_URL=redis://localhost:6379

# --- API service ---
API_PORT=4000
# Public base URL of the API (used by web + Stripe redirect/webhook targets).
API_BASE_URL=http://localhost:4000

# --- Web app ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# API URL the browser/server calls. Public one is exposed to the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth (Auth.js / NextAuth v5). Shared secret: web signs, api verifies. ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-secret
AUTH_URL=http://localhost:3000

# --- Payments (Stripe, TEST mode). Leave PAYMENTS_ENABLED=false to run without keys. ---
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Email (Nodemailer). Dev uses Mailhog from docker-compose. ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Booking <no-reply@booking.local>"

# --- Reminders / booking lifecycle ---
# How long before the booking start the reminder email is sent.
REMINDER_LEAD_MINUTES=1440
# Unpaid PENDING_PAYMENT bookings older than this are cancelled (slot freed).
PENDING_EXPIRY_MINUTES=15
